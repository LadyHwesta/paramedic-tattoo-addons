<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_practice" model="ir.ui.view">
        <field name="name">res.config.settings.form.practice.appointment</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Practice Appointments"
                     string="Practice Appointments" name="practice_appointment"
                     groups="practice_base.group_practice_staff">
                    <block title="Scheduling" name="practice_appointment_settings">
                        <setting id="practice_reminder_setting"
                                 string="Appointment reminders">
                            <field name="practice_reminder_lead_days" />
                            <span class="text-muted">days before the appointment</span>
                        </setting>
                        <setting id="practice_horizon_setting"
                                 string="Online booking window">
                            <field name="practice_booking_horizon_days" />
                            <span class="text-muted">days ahead</span>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
