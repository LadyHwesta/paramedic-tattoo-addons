    <record id="channel_scheduling" model="slide.channel">
        <field name="name">Scheduling &amp; Booking</field>
        <field name="image_1920" type="base64" file="practice_elearning/static/img/cover_scheduling.png" />
        <field name="channel_type">training</field>
        <field name="description" type="html"><p>Set up practitioners and services, book appointments, confirm online requests, and let clients book themselves.</p></field>
        <field name="visibility">members</field>
        <field name="enroll">invite</field>
        <field name="is_published" eval="True" />
        <field name="enroll_group_ids" eval="[(6, 0, [ref('practice_base.group_practice_staff')])]" />
