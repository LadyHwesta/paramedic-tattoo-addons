<odoo noupdate="1">

    <record id="channel_billing" model="slide.channel">
        <field name="name">Billing Clients</field>
        <field name="image_1920" type="base64" file="practice_elearning_billing/static/img/cover_billing.png" />
        <field name="channel_type">training</field>
        <field name="description" type="html"><p>Price your services, invoice each visit in one click, take payment at the desk, and see who still owes.</p></field>
        <field name="visibility">members</field>
        <field name="enroll">invite</field>
        <field name="is_published" eval="True" />
