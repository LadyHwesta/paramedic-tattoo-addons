<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_paramedic" model="ir.ui.view">
        <field name="name">res.config.settings.form.paramedic.appointment</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Paramedical Appointments"
                     string="Paramedical Appointments" name="paramedic_appointment"
                     groups="paramedic_base.group_paramedic_staff">
                    <block title="Scheduling" name="paramedic_appointment_settings">
                        <setting id="paramedic_reminder_setting"
                                 string="Appointment reminders">
                            <field name="paramedic_reminder_lead_days" />
                            <span class="text-muted">days before the appointment</span>
                        </setting>
                        <setting id="paramedic_horizon_setting"
                                 string="Online booking window">
                            <field name="paramedic_booking_horizon_days" />
                            <span class="text-muted">days ahead</span>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
