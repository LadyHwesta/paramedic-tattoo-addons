<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="paramedic_appointment_view_list" model="ir.ui.view">
        <field name="model">paramedic.appointment</field>
        <field name="arch" type="xml">
            <list>
                <field name="start" />
                <field name="partner_id" />
                <field name="service_id" />
                <field name="practitioner_id" />
                <field name="source" optional="hide" />
                <field name="state" widget="badge"
                       decoration-info="state == 'requested'"
                       decoration-success="state == 'confirmed'"
                       decoration-muted="state in ('completed', 'cancelled', 'no_show')" />
            </list>
        </field>
    </record>

    <record id="paramedic_appointment_view_form" model="ir.ui.view">
        <field name="model">paramedic.appointment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'requested'" />
                    <button name="action_complete" type="object" string="Complete"
                            class="btn-primary" invisible="state != 'confirmed'" />
                    <button name="action_no_show" type="object" string="No-show"
                            invisible="state not in ('requested', 'confirmed')" />
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('cancelled', 'completed')" />
                    <field name="state" widget="statusbar"
                           statusbar_visible="requested,confirmed,completed" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_session" type="object"
                                class="oe_stat_button" icon="fa-heartbeat"
                                invisible="not session_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Session</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" />
                            <field name="condition_id" />
                            <field name="service_id" />
                            <field name="practitioner_id" />
                        </group>
                        <group>
                            <field name="start" />
                            <field name="stop" readonly="1" />
                            <field name="duration_display" />
                            <field name="source" />
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..." />
                    <field name="session_id" invisible="1" />
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="paramedic_appointment_view_calendar" model="ir.ui.view">
        <field name="model">paramedic.appointment</field>
        <field name="arch" type="xml">
            <calendar string="Appointments" date_start="start" date_stop="stop"
                      color="practitioner_id" mode="week">
                <field name="partner_id" />
                <field name="service_id" />
                <field name="state" />
            </calendar>
        </field>
    </record>

    <record id="paramedic_appointment_view_search" model="ir.ui.view">
        <field name="model">paramedic.appointment</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id" />
                <field name="practitioner_id" />
                <field name="service_id" />
                <filter name="requested" string="Needs Confirmation"
                        domain="[('state', '=', 'requested')]" />
                <filter name="upcoming" string="Upcoming"
                        domain="[('start', '&gt;=', context_today().strftime('%Y-%m-%d'))]" />
                <separator />
                <group>
                    <filter name="group_practitioner" string="Practitioner"
                            context="{'group_by': 'practitioner_id'}" />
                    <filter name="group_service" string="Service"
                            context="{'group_by': 'service_id'}" />
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_paramedic_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">paramedic.appointment</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="context">{'search_default_upcoming': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Schedule an appointment</p>
        </field>
    </record>

    <record id="action_paramedic_appointment_requested" model="ir.actions.act_window">
        <field name="name">Requested Appointments</field>
        <field name="res_model">paramedic.appointment</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="context">{'search_default_requested': 1}</field>
    </record>

</odoo>
