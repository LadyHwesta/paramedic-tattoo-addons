<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="mail_template_appointment_confirmed" model="mail.template">
        <field name="name">Appointment: confirmed</field>
        <field name="model_id" ref="model_paramedic_appointment" />
        <field name="subject">Appointment confirmed - {{ object.service_id.name }}</field>
        <field name="email_from">{{ (object.practitioner_id.partner_id.email_formatted or user.email_formatted) }}</field>
        <field name="email_to">{{ object.partner_id.email_formatted }}</field>
        <field name="body_html" type="html">
            <div style="margin:0;padding:0;">
                <p>Hi <t t-out="object.partner_id.name or ''" />,</p>
                <p>
                    Your <strong t-out="object.service_id.name or ''" />
                    appointment with <strong t-out="object.practitioner_id.display_name or ''" />
                    is confirmed for
                    <strong t-out="format_datetime(object.start, tz=object.partner_id.tz, dt_format='medium') or ''" />.
                </p>
                <p>Need to reschedule? Reply to this email or call the studio.</p>
            </div>
        </field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True" />
    </record>

    <record id="mail_template_appointment_reminder" model="mail.template">
        <field name="name">Appointment: reminder</field>
        <field name="model_id" ref="model_paramedic_appointment" />
        <field name="subject">Reminder: {{ object.service_id.name }} appointment</field>
        <field name="email_from">{{ (object.practitioner_id.partner_id.email_formatted or user.email_formatted) }}</field>
        <field name="email_to">{{ object.partner_id.email_formatted }}</field>
        <field name="body_html" type="html">
            <div style="margin:0;padding:0;">
                <p>Hi <t t-out="object.partner_id.name or ''" />,</p>
                <p>
                    A reminder of your <strong t-out="object.service_id.name or ''" />
                    appointment with <strong t-out="object.practitioner_id.display_name or ''" />,
                    starting
                    <strong t-out="format_datetime(object.start, tz=object.partner_id.tz, dt_format='medium') or ''" />.
                </p>
                <p>See you soon.</p>
            </div>
        </field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True" />
    </record>
</odoo>
