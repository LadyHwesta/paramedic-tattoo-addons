<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ir_cron_appointment_reminders" model="ir.cron">
        <field name="name">Paramedic Appointments: send reminders</field>
        <field name="model_id" ref="model_paramedic_appointment" />
        <field name="state">code</field>
        <field name="code">model._cron_send_reminders()</field>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True" />
    </record>
</odoo>
