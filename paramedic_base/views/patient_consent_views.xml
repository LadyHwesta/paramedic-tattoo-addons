<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="patient_consent_view_list" model="ir.ui.view">
        <field name="model">patient.consent</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id" />
                <field name="condition_id" />
                <field name="consent_type" />
                <field name="date" />
                <field name="signed" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="patient_consent_view_form" model="ir.ui.view">
        <field name="model">patient.consent</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_signed" type="object"
                            string="Mark Signed" class="btn-primary"
                            invisible="signed" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="1" />
                            <field name="condition_id" />
                            <field name="consent_type" />
                        </group>
                        <group>
                            <field name="date" />
                            <field name="signed" />
                            <field name="signature_method" />
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..." />
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_patient_consent" model="ir.actions.act_window">
        <field name="name">Consents</field>
        <field name="res_model">patient.consent</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
