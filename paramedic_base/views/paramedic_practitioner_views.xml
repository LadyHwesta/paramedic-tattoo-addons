<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="paramedic_practitioner_view_list" model="ir.ui.view">
        <field name="model">paramedic.practitioner</field>
        <field name="arch" type="xml">
            <list>
                <field name="display_name" string="Practitioner" />
                <field name="user_id" />
                <field name="resource_calendar_id" />
                <field name="license_number" />
                <field name="active" column_invisible="1" />
            </list>
        </field>
    </record>

    <record id="paramedic_practitioner_view_form" model="ir.ui.view">
        <field name="model">paramedic.practitioner</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active" />
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id" />
                            <field name="resource_calendar_id" />
                            <field name="color" widget="color_picker" />
                            <field name="active" invisible="1" />
                        </group>
                        <group>
                            <field name="license_number" />
                            <field name="npi_number" />
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_paramedic_practitioner" model="ir.actions.act_window">
        <field name="name">Practitioners</field>
        <field name="res_model">paramedic.practitioner</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a practitioner</p>
            <p>Every practitioner needs a user login and their own working
               hours. Appointments and treatment continuity are tracked
               per practitioner.</p>
        </field>
    </record>

</odoo>
