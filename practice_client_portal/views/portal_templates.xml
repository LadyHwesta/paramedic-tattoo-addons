<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template id="portal_my_home_records" name="Portal home: My Records"
              customize_show="True" inherit_id="portal.portal_my_home" priority="21">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_service_category_enable" t-value="True" />
        </xpath>
        <div id="portal_service_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/web/static/img/folder.svg'" />
                <t t-set="title">My Records</t>
                <t t-set="url" t-value="'/my/records'" />
                <t t-set="text">Updates from your provider, and your photos</t>
                <t t-set="placeholder_count" t-value="'client_record_count'" />
            </t>
        </div>
    </template>

    <template id="portal_my_records" name="My Records">
        <t t-call="portal.portal_layout">
            <h3 class="mb-4">My Records</h3>
            <div t-if="saved" class="alert alert-success" role="status">Your choice is saved.</div>

            <h5>Updates from your provider</h5>
            <p t-if="not notes" class="text-muted">Nothing shared with you yet.</p>
            <div t-foreach="notes" t-as="note" class="border rounded p-3 mb-3">
                <div class="d-flex justify-content-between">
                    <strong t-out="note.title" />
                    <span class="text-muted small">
                        <span t-out="note.date" t-options="{'widget': 'date'}" />
                        · <span t-out="note.author_id.name" />
                    </span>
                </div>
                <div class="mt-2" t-out="note.body" />
            </div>

            <h5 class="mt-4" id="photos">Your photos</h5>
            <p t-if="not photos" class="text-muted">No photos shared with you yet.</p>
            <p t-if="photos" class="text-muted">
                You decide which photos your provider may use in their marketing, such as their
                website or portfolio. You can change your mind any time; photos already printed
                or published before you do may take time to come down.
            </p>
            <div class="row g-3">
                <div t-foreach="photos" t-as="photo" class="col-6 col-md-4">
                    <div class="border rounded p-2 h-100 d-flex flex-column">
                        <img t-att-src="'/my/records/photo/%s' % photo.id" class="img-fluid rounded mb-2"
                             t-att-alt="'%s photo, %s' % (dict(photo._fields['kind'].selection)[photo.kind], photo.date and photo.date.date())"
                             style="object-fit: cover; aspect-ratio: 1;" />
                        <div class="small text-muted mb-2">
                            <t t-out="dict(photo._fields['kind'].selection)[photo.kind]" /> ·
                            <span t-out="photo.date" t-options="{'widget': 'date'}" />
                        </div>
                        <form method="post" t-attf-action="/my/records/photo/#{photo.id}/marketing" class="mt-auto">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                            <t t-if="photo.marketing_ok">
                                <div class="badge text-bg-success mb-2">OK to use in marketing</div>
                                <input type="hidden" name="allow" value="0" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary w-100">Withdraw permission</button>
                            </t>
                            <t t-else="">
                                <input type="hidden" name="allow" value="1" />
                                <button type="submit" class="btn btn-sm btn-outline-primary w-100">Allow use in marketing</button>
                            </t>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
