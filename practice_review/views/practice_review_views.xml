<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="practice_review_view_list" model="ir.ui.view">
        <field name="model">practice.review</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="create_date" string="Received" widget="date" />
                <field name="practitioner_id" />
                <field name="partner_id" />
                <field name="stars" string="Rating" />
                <field name="title" />
                <field name="state" widget="badge"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state == 'published'"
                       decoration-muted="state in ('rejected', 'withdrawn')" />
            </list>
        </field>
    </record>

    <record id="practice_review_view_form" model="ir.ui.view">
        <field name="model">practice.review</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="action_publish" type="object" string="Publish" class="btn-primary"
                            invisible="state not in ('submitted', 'rejected')"
                            confirm="Publish this review on the website, with the photos the client chose?" />
                    <button name="action_reject" type="object" string="Don't Publish"
                            invisible="state not in ('submitted', 'published')" />
                    <field name="state" widget="statusbar" statusbar_visible="submitted,published" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="title" /></h1>
                        <h3 class="text-warning"><field name="stars" /></h3>
                    </div>
                    <group>
                        <group>
                            <field name="practitioner_id" />
                            <field name="partner_id" />
                            <field name="display_name_public" />
                        </group>
                        <group>
                            <field name="create_date" string="Received" />
                            <field name="moderated_by_id" invisible="not moderated_by_id" />
                            <field name="moderated_date" invisible="not moderated_date" />
                            <field name="blog_post_id" invisible="not blog_post_id" />
                        </group>
                    </group>
                    <group string="Review">
                        <field name="body" nolabel="1" colspan="2" />
                    </group>
                    <group string="Photos the client chose" invisible="not photo_ids">
                        <field name="photo_ids" nolabel="1" colspan="2" mode="kanban">
                            <kanban>
                                <templates>
                                    <t t-name="card">
                                        <field name="image" widget="image" options="{'size': [120, 120]}" />
                                        <field name="kind" />
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                    </group>
                    <group string="If it isn't published" invisible="state not in ('submitted', 'rejected')">
                        <field name="reject_reason" nolabel="1" colspan="2"
                               placeholder="Optional: a short note the client sees in their portal" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="practice_review_view_search" model="ir.ui.view">
        <field name="model">practice.review</field>
        <field name="arch" type="xml">
            <search>
                <field name="practitioner_id" />
                <field name="partner_id" />
                <field name="title" />
                <filter name="to_review" string="To Review" domain="[('state', '=', 'submitted')]" />
                <filter name="published" string="Published" domain="[('state', '=', 'published')]" />
                <separator />
                <group>
                    <filter name="group_practitioner" string="Practitioner" context="{'group_by': 'practitioner_id'}" />
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_practice_review" model="ir.actions.act_window">
        <field name="name">Reviews</field>
        <field name="res_model">practice.review</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_review': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No reviews to check</p>
            <p>After a completed visit, clients can review their practitioner in their portal.
               Each review waits here until someone publishes it to the Client Reviews blog.</p>
        </field>
    </record>

    <menuitem id="menu_practice_review" name="Reviews" parent="practice_base.menu_practice_root"
              action="action_practice_review" sequence="35" />

    <record id="res_config_settings_view_form_practice_review" model="ir.ui.view">
        <field name="name">res.config.settings.form.practice.review</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="practice_appointment.res_config_settings_view_form_practice" />
        <field name="arch" type="xml">
            <block name="practice_appointment_settings" position="after">
                <block title="Reviews" name="practice_review_settings">
                    <setting id="practice_review_moderator" string="Reviews checked by"
                             help="Gets a to-do for each new review. Leave empty for the administrator.">
                        <field name="practice_review_moderator_id" />
                    </setting>
                </block>
            </block>
        </field>
    </record>

</odoo>
