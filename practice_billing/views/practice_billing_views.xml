<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="practice_service_view_form_billing" model="ir.ui.view">
        <field name="model">practice.service</field>
        <field name="inherit_id" ref="practice_appointment.practice_service_view_form" />
        <field name="arch" type="xml">
            <field name="duration" position="before">
                <field name="list_price" />
                <field name="product_id" />
            </field>
        </field>
    </record>

    <record id="practice_service_view_list_billing" model="ir.ui.view">
        <field name="model">practice.service</field>
        <field name="inherit_id" ref="practice_appointment.practice_service_view_list" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="list_price" />
            </field>
        </field>
    </record>

    <record id="practice_appointment_view_form_billing" model="ir.ui.view">
        <field name="model">practice.appointment</field>
        <field name="inherit_id" ref="practice_appointment.practice_appointment_view_form" />
        <field name="arch" type="xml">
            <button name="action_no_show" position="before">
                <field name="invoice_id" invisible="1" />
                <button name="action_create_invoice" type="object" string="Create Invoice"
                        class="btn-primary" invisible="state != 'completed' or invoice_id"
                        groups="account.group_account_invoice" />
            </button>
            <div name="button_box" position="inside">
                <button name="action_view_invoice" type="object" class="oe_stat_button"
                        icon="fa-pencil-square-o" invisible="not invoice_id"
                        groups="account.group_account_invoice">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Invoice</span>
                        <span class="o_stat_value"><field name="payment_state" readonly="1" /></span>
                    </div>
                </button>
            </div>
        </field>
    </record>

    <record id="practice_appointment_view_list_billing" model="ir.ui.view">
        <field name="model">practice.appointment</field>
        <field name="inherit_id" ref="practice_appointment.practice_appointment_view_list" />
        <field name="arch" type="xml">
            <list position="inside">
                <field name="payment_state" optional="show" widget="badge"
                       groups="account.group_account_invoice"
                       decoration-success="payment_state in ('paid', 'in_payment')"
                       decoration-warning="payment_state in ('not_paid', 'partial')" />
                <header>
                    <button name="action_create_invoice" type="object" string="Create Invoices"
                            groups="account.group_account_invoice" />
                </header>
            </list>
        </field>
    </record>

    <record id="practice_appointment_view_search_billing" model="ir.ui.view">
        <field name="model">practice.appointment</field>
        <field name="inherit_id" ref="practice_appointment.practice_appointment_view_search" />
        <field name="arch" type="xml">
            <filter name="upcoming" position="after">
                <filter name="to_invoice" string="To Invoice" domain="[('to_invoice', '=', True)]"
                        groups="account.group_account_invoice" />
            </filter>
        </field>
    </record>
</odoo>
