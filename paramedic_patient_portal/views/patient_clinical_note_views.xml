<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="patient_clinical_note_view_list" model="ir.ui.view">
        <field name="name">patient.clinical.note.list</field>
        <field name="model">patient.clinical.note</field>
        <field name="arch" type="xml">
            <list>
                <field name="date" />
                <field name="partner_id" />
                <field name="title" />
                <field name="session_id" optional="show" />
                <field name="author_id" optional="show" />
                <field name="visibility" widget="badge"
                       decoration-muted="visibility == 'internal'"
                       decoration-info="visibility == 'patient'" />
            </list>
        </field>
    </record>

    <record id="patient_clinical_note_view_form" model="ir.ui.view">
        <field name="name">patient.clinical.note.form</field>
        <field name="model">patient.clinical.note</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="visibility" widget="radio" options="{'horizontal': true}" />
                </header>
                <sheet>
                    <div class="alert alert-info mb-3" role="status"
                         invisible="visibility != 'patient'">
                        The patient sees this note in their portal, and was emailed that there's
                        an update (not the note itself).
                    </div>
                    <div class="oe_title">
                        <h1><field name="title" placeholder="e.g. Two-week healing check" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" />
                            <field name="condition_id" />
                            <field name="session_id" />
                        </group>
                        <group>
                            <field name="date" />
                            <field name="author_id" />
                            <field name="shared_on" invisible="not shared_on" />
                        </group>
                    </group>
                    <field name="body" placeholder="Write the note..." />
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="patient_clinical_note_view_search" model="ir.ui.view">
        <field name="name">patient.clinical.note.search</field>
        <field name="model">patient.clinical.note</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id" />
                <field name="title" />
                <field name="body" />
                <filter name="internal" string="Internal" domain="[('visibility', '=', 'internal')]" />
                <filter name="shared" string="Shared with patient" domain="[('visibility', '=', 'patient')]" />
                <group>
                    <filter name="group_patient" string="Patient" context="{'group_by': 'partner_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_patient_clinical_note" model="ir.actions.act_window">
        <field name="name">Clinical Notes</field>
        <field name="res_model">patient.clinical.note</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_patient_clinical_note"
              name="Clinical Notes"
              parent="paramedic_base.menu_paramedic_clinical"
              action="action_patient_clinical_note"
              sequence="5" />

</odoo>
