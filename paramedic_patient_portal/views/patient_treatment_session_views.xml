<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="patient_treatment_session_view_form_portal" model="ir.ui.view">
        <field name="name">patient.treatment.session.form.portal</field>
        <field name="model">patient.treatment.session</field>
        <field name="inherit_id" ref="paramedic_base.patient_treatment_session_view_form" />
        <field name="arch" type="xml">
            <page name="after_photos" position="after">
                <page string="Sharing &amp; Marketing" name="photo_sharing">
                    <p class="text-muted">Tick a photo to show it in the patient's portal, where
                    they can allow its use in marketing.</p>
                    <field name="photo_ids" context="{'tree_view_ref': 'paramedic_patient_portal.patient_photo_view_list'}" />
                </page>
                <page string="Notes" name="clinical_notes">
                    <field name="clinical_note_ids"
                           context="{'default_partner_id': partner_id, 'default_session_id': id, 'default_condition_id': condition_id}">
                        <list>
                            <field name="date" />
                            <field name="title" />
                            <field name="author_id" />
                            <field name="visibility" widget="badge"
                                   decoration-muted="visibility == 'internal'"
                                   decoration-info="visibility == 'patient'" />
                        </list>
                    </field>
                </page>
            </page>
        </field>
    </record>

</odoo>
