<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="practice_plan_view_list" model="ir.ui.view">
        <field name="model">practice.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id" />
                <field name="plan_type_id" />
                <field name="area" />
                <field name="start_date" />
                <field name="practitioner_id" />
                <field name="test_clear" widget="boolean_toggle" />
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'active'"
                       decoration-muted="state in ('completed', 'discontinued')" />
            </list>
        </field>
    </record>

    <record id="practice_plan_view_form" model="ir.ui.view">
        <field name="model">practice.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,completed" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sessions" type="object"
                                class="oe_stat_button" icon="fa-calendar-check-o">
                            <field name="session_count" widget="statinfo"
                                   string="Sessions" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" />
                            <field name="plan_type_id" />
                            <field name="area" />
                        </group>
                        <group>
                            <field name="practitioner_id" />
                            <field name="start_date" />
                            <field name="test_clear" invisible="1" />
                        </group>
                    </group>
                    <field name="background" placeholder="History, goals, anything from a referring provider..." />
                    <notebook>
                        <page string="Consents" name="consents">
                            <field name="consent_ids">
                                <list editable="bottom">
                                    <field name="consent_type" />
                                    <field name="form_id" />
                                    <field name="date" />
                                    <field name="signed" widget="boolean_toggle" />
                                    <field name="signature_method" />
                                </list>
                            </field>
                        </page>
                        <page string="Pre-treatment Tests" name="tests">
                            <field name="test_ids">
                                <list editable="bottom">
                                    <field name="test_type_id" />
                                    <field name="product_name" />
                                    <field name="product_lot" />
                                    <field name="test_date" />
                                    <field name="read_date" />
                                    <field name="result" widget="badge"
                                           decoration-success="result == 'clear'"
                                           decoration-danger="result == 'reaction'"
                                           decoration-warning="result == 'pending'" />
                                </list>
                            </field>
                        </page>
                        <page string="Sessions" name="sessions">
                            <field name="session_ids" context="{
                                'default_plan_id': id,
                                'default_partner_id': partner_id,
                                'default_practitioner_id': practitioner_id}">
                                <list editable="bottom">
                                    <field name="session_number" />
                                    <field name="date" />
                                    <field name="practitioner_id" />
                                    <field name="area_treated" />
                                    <field name="adverse_reaction"
                                           widget="boolean_toggle" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="practice_plan_view_search" model="ir.ui.view">
        <field name="model">practice.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id" />
                <field name="practitioner_id" />
                <field name="plan_type_id" />
                <filter name="active_treatment" string="In Treatment"
                        domain="[('state', '=', 'active')]" />
                <filter name="test_needed" string="Test Not Clear"
                        domain="[('test_clear', '=', False)]" />
                <separator />
                <group>
                    <filter name="group_practitioner" string="Practitioner"
                            context="{'group_by': 'practitioner_id'}" />
                    <filter name="group_plan_type" string="Treatment"
                            context="{'group_by': 'plan_type_id'}" />
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_practice_plan" model="ir.actions.act_window">
        <field name="name">Treatment Plans</field>
        <field name="res_model">practice.plan</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active_treatment': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Start a client's treatment plan</p>
            <p>Every consent, pre-treatment test and session for a client
               hangs off the plan for what's being treated.</p>
        </field>
    </record>

</odoo>
