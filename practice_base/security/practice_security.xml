<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="module_category_practice" model="ir.module.category">
        <field name="name">Practice</field>
        <field name="sequence">20</field>
    </record>

    <record id="privilege_practice" model="res.groups.privilege">
        <field name="name">Practice</field>
        <field name="category_id" ref="module_category_practice" />
        <field name="sequence">10</field>
    </record>

    <record id="group_practice_staff" model="res.groups">
        <field name="name">Practitioner / Staff</field>
        <field name="privilege_id" ref="privilege_practice" />
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
        <field name="comment">Full access to client records, treatment plans,
            consents, pre-treatment tests and sessions. Never grant this
            to a portal or public user.</field>
    </record>

</odoo>
